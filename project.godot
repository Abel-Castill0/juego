; UMBRAL — Godot 4.7.x — prototipo fase 1.
; Abrir con el editor Godot para importar assets .wav antes de jugar.
config_version=5

[application]
config/name="UMBRAL | Supervivencia MVP"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
InputBootstrap="*res://scripts/input_bootstrap.gd"
ItemDB="*res://scripts/item_database.gd"
GameClock="*res://scripts/game_clock.gd"

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2

[physics]
3d/default_gravity=21.0

[editor]
run/main_run_args=""
